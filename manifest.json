{
  "manifest_version": 3,
  "name": "SubView \u2014 Video Sync",
  "version": "0.2.0",
  "description": "Watch Sub with Dub audio: syncs a visible video with background audio, a hidden copy of the page, or another tab.",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "SubView \u2014 Video Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
